<div class="container mt-3">
    <h1><%= @quest.title %></h1>
    <p><strong>Description:</strong> <%= @quest.description %></p>
    <p><strong>Category:</strong> <%= @quest.category %></p>
    <p><strong>Difficulty:</strong> <%= @quest.difficulty.capitalize %></p>
    <p><strong>Time:</strong> <%= @quest.duration_minutes %> minutes</p>

    <%= link_to "Back to all quests", quests_path, class: "btn btn-primary" %>
    <%= link_to "Delete this quest", quest_path(@quest), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-danger"  %>
    <%= link_to "Edit this quest", edit_quest_path(@quest), class: "btn btn-success" %>
</div>